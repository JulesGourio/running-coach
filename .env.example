# Copie ce fichier en .env et complète si besoin. Tout est optionnel.

# Serveur officiel COROS. COROS_REGION choisit l'hôte MCP par défaut (eu, us, asia/cn) ;
# ne renseigne COROS_MCP_URL que pour le forcer explicitement.
COROS_REGION=eu
COROS_MCP_URL=

# Solution de repli : API non officielle COROS (seulement si la connexion officielle échoue).
COROS_EMAIL=
COROS_PASSWORD=

# Profil athlète : laisse vide pour une estimation automatique depuis tes séances.
# Valeurs visibles dans l'app COROS, rubrique Zones.
ATHLETE_HR_MAX=
ATHLETE_HR_REST=
ATHLETE_LTHR=
ATHLETE_THRESHOLD_PACE=
ATHLETE_SEX=M

# Objectif
GOAL_LABEL=10 km
GOAL_DATE=2026-12-13
GOAL_DISTANCE_M=10000
GOAL_TIME_A=40:00
GOAL_TIME_B=41:30
